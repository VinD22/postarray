{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Post Array: a multilingual social publishing control plane for people and agents.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @relay/database generate",
    "db:migrate": "pnpm --filter @relay/database migrate",
    "db:migrations:verify": "pnpm --filter @relay/database migrations:verify",
    "db:seed": "pnpm --filter @relay/database seed",
    "db:reset": "pnpm --filter @relay/database reset",
    "release:check": "node scripts/release-check.js",
    "test:rls": "node scripts/rls-test.js",
    "verify": "turbo run typecheck lint test",
    "generate:marketing-states": "pnpm --filter @relay/connectors generate:marketing-states",
    "generate:publishing-limits": "pnpm --filter @relay/connectors generate:publishing-limits"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0"
  }
}
