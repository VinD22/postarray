{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "build": "tsup",
    "dev": "node --import tsx/esm src/main.ts",
