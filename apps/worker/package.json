{
  "name": "@relay/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./activities": "./src/activities/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@relay/application": "workspace:*",
    "@relay/config": "workspace:*",
    "@relay/contracts": "workspace:*",
    "@relay/database": "workspace:*",
    "@relay/observability": "workspace:*",
    "@relay/runtime": "workspace:*",
    "@temporalio/common": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
