# apps/web environment.
#
# Copy to .env.local. Placeholders only: never commit a real value here or
# anywhere else in this repository.
#
# For a full list of backend secrets (Neon, Temporal, providers, Polar, etc.),
# ops should use docs/runbooks/ops-secrets-and-keys-handoff.md. This file is only
# the public Next.js variables for the web surface.

# The Relay REST API.
#
NEXT_PUBLIC_RELAY_API_URL=

# Optional local review mode. Ignored when NODE_ENV=production. In this mode
# the shell labels every seeded workspace and nothing can publish.
NEXT_PUBLIC_RELAY_DEMO_MODE=false

# The public origin of this app. Used to build OAuth return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The public, canonical origin of the marketing site. Used for canonical URLs,
# structured data, hreflang alternates, and the sitemap. Set this to the exact
# HTTPS origin served in each deployed environment, without a trailing slash.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Development only. Enables direct /en-XA and /en-XB pseudo-locale routes for
# layout and bidirectional testing. It is ignored outside development.
NEXT_PUBLIC_ENABLE_PSEUDO_LOCALES=false

# The short link service origin, shown in composer link previews.
NEXT_PUBLIC_SHORT_LINK_BASE_URL=http://localhost:3002

# Optional. Client error reporting. Leave unset to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Product analytics. Leave unset to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
