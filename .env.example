# =============================================================================
# Relay: example environment file.
#
# Copy to `.env` and fill in real values locally. NEVER commit a real `.env`.
# Every value here is a placeholder. The application boots in a safe local mode
# when optional providers are absent: the affected feature is disabled with a
# truthful admin message instead of crashing unrelated surfaces.
#
# Ops handoff: see docs/runbooks/ops-secrets-and-keys-handoff.md for the full
# checklist platform should deliver per environment (staging, production, isolated
# release branch). Do not paste real secrets into tickets or git.
#
# Required to boot locally:  DATABASE_URL, APP_URL, API_URL, TOKEN_ENCRYPTION_LOCAL_KEY
# Everything else is optional and degrades gracefully.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Public canonical origin for web SEO metadata. Set a production HTTPS origin
# without a trailing slash when deploying the web surface. A production build
# of apps/web fails rather than inline this localhost default: NEXT_PUBLIC_* is
# substituted at build time, so a shipped localhost canonical cannot be
# corrected at runtime.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Development only. Enables pseudo-locale layout test routes in the web app.
NEXT_PUBLIC_ENABLE_PSEUDO_LOCALES=false
# Local-only opt-in that makes the in-repo fake provider simulator dispatchable
# so the seeded publish loop can run offline. Honored only when NODE_ENV is
# development or test; it must never be true in production and is ignored there.
RELAY_ALLOW_FAKE_CONNECTOR=false
LOG_LEVEL=info

# --- Database (Neon Postgres) -----------------------------------------------
# DATABASE_URL goes through the pooler; DIRECT_DATABASE_URL is used by migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay?schema=public

# --- Neon Auth and Object Storage ------------------------------------------
# Auth is provisioned per Neon branch: Neon Auth must be provisioned for the
# project first (Neon console > Auth, or the Neon MCP provision_neon_auth
# action). The provisioning output supplies these three values: the Better
# Auth REST base URL, a server-only cookie secret of at least 32 characters
# (generate your own if not supplied), and the JWKS URL for session
# verification. Sign-up and sign-in fail with a clear "identity provider not
# configured" error until they are set. See docs/runbooks/local-development.md.
# Storage is S3-compatible and currently beta.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_JWKS_URL=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=relay-media
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# --- Redis / Valkey ---------------------------------------------------------
# Rate limiting, idempotency hot paths, short-lived locks. Absent = in-memory
# fallback suitable for a single local process only.
REDIS_URL=redis://localhost:6379

# --- Temporal ---------------------------------------------------------------
# Durable scheduling and publishing workflows. Absent = in-process test scheduler.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=relay-publishing
TEMPORAL_API_KEY=

# --- Polar (billing, merchant of record) ------------------------------------
# One public plan: $29/month or $300/year, both with a 7-day trial that collects
# a payment method and charges $0 at checkout.
# Keep false until the merchant identity, legal copy, production products and
# webhook are verified. Credentials alone do not enable checkout.
BILLING_CHECKOUT_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_MONTHLY_PRODUCT_ID=
POLAR_ANNUAL_PRODUCT_ID=
POLAR_TRIAL_DAYS=7

# --- AI gateway (provider-neutral) ------------------------------------------
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROMPT_VERSION=2026-08-04
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_MONTHLY_USD_PER_WORKSPACE=25

# --- Encryption / KMS -------------------------------------------------------
# Production uses envelope encryption with a KMS-managed master key.
# TOKEN_ENCRYPTION_LOCAL_KEY is a 32-byte base64 key for local development only.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KMS_KEY_ID=
TOKEN_ENCRYPTION_KMS_REGION=us-east-2
TOKEN_ENCRYPTION_LOCAL_KEY=

# --- First-party OAuth issuer (third-party developer apps + MCP) ------------
OAUTH_ISSUER_URL=http://localhost:3001
OAUTH_SIGNING_KMS_KEY_ID=
OAUTH_SIGNING_LOCAL_KEY=

# --- Short links ------------------------------------------------------------
# The redirect domain must be isolated from the main app/session domain.
SHORT_LINK_BASE_URL=http://localhost:3002
SHORT_LINK_HASH_KEY=

# --- Email ------------------------------------------------------------------
# Transactional email. The default API URL is Resend-compatible.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM="Relay <no-reply@example.test>"

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# Social provider credentials.
# A connector without credentials is reported as "not configured" in the admin
# panel and hidden from the connect flow. It never breaks other connectors.
# =============================================================================

# X (pay-per-operation API; URL posts cost materially more than plain text)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn (member + organization publishing; requires Community Management review)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta: Instagram, Facebook Pages, Threads (one app, reviewed permissions)
META_APP_ID=
META_APP_SECRET=

# Google / YouTube (unaudited projects upload privately only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok (Content Posting API; unaudited posts are private)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Bluesky (AT Protocol; launch fallback connector)
BLUESKY_SERVICE_URL=https://bsky.social

# Mastodon (per-instance OAuth; app registered on the instance)
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_INSTANCE_URL=https://mastodon.social

# Telegram (official Bot API; a bot token per account)
TELEGRAM_BOT_TOKEN=

# Reddit (official OAuth; requires app review for write scopes)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# WordPress (official REST API; OAuth2 application, or site app passwords)
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# Medium (official integration API)
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=

# Dev.to (official API; per-account API key)
DEVTO_API_KEY=

# Pinterest (official v5 API; app review required)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Discord (official Bot API; a bot token)
DISCORD_BOT_TOKEN=

# Slack (official API; OAuth app for chat:write)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
