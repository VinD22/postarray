{
  "name": "@relay/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./reviews": "./src/reviews.ts",
    "./review-gate": "./src/review-gate.ts",
    "./messages": "./src/messages/index.ts",
    "./format": "./src/format.ts",
