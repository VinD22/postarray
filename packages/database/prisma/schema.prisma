  changeLog      Json         @default("[]") @map("change_log")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([officialUrl])
  @@index([state, category])
  @@index([state, lastVerifiedAt])
  @@map("tool_catalog_entries")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Connections, media and publishing
// ---------------------------------------------------------------------------

model SocialConnection {
  id                String              @id @default(dbgenerated("app.new_id('conn')"))
  workspaceId       String              @map("workspace_id")
  brandId           String?             @map("brand_id")
  provider          ProviderKind
  externalAccountId String              @map("external_account_id")
  accountType       ExternalAccountType @map("account_type")
  displayName       String              @map("display_name")
  handle            String?
  avatarUrl         String?             @map("avatar_url")
  profileUrl        String?             @map("profile_url")
  status            ConnectionStatus    @default(active)
  statusReason      String?             @map("status_reason")
  grantedScopes     String[]            @default([]) @map("granted_scopes")
  /// Data, not code. Records the account-specific limits and permissions in
  /// force. Saved at approval and revalidated immediately before publish.
  capabilities      Json                @default("{}")
  capabilityVersion String?             @map("capability_version")
  capabilitiesRefreshedAt DateTime?     @map("capabilities_refreshed_at") @db.Timestamptz(6)
  lastSuccessfulActionAt DateTime?      @map("last_successful_action_at") @db.Timestamptz(6)
  connectedAt       DateTime            @default(now()) @map("connected_at") @db.Timestamptz(6)
  disconnectedAt    DateTime?           @map("disconnected_at") @db.Timestamptz(6)
  createdByUserId   String?             @map("created_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  credential          SocialCredential?
  destinations        ProviderDestination[]
  mentionEntities     MentionEntity[]
  postVariants        PostVariant[]
  publishJobs         PublishJob[]
  publishAttempts     PublishAttempt[]
  receipts            PublicationReceipt[]
  providerLimits      ProviderLimit[]
  incidents           ConnectionIncident[]
  analyticsSyncRuns   AnalyticsSyncRun[]
  metricObservations  MetricObservation[]

  // One row per external account per workspace, forever. Disconnect flips
  // `status`; reconnect updates the same row so history and receipts survive.
  @@unique([provider, externalAccountId, workspaceId], map: "uq_social_connections_provider_account_workspace")
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, brandId, provider])
  @@map("social_connections")
  @@schema("app")
}

/// Envelope encrypted. Ciphertext, nonce, algorithm and key version are stored
/// separately so a key rotation can re-encrypt without touching the plaintext
/// path. Workers decrypt immediately before a provider request and never place
/// a token in a Temporal history, log, trace or client payload.
model SocialCredential {
  id                    String    @id @default(dbgenerated("app.new_id('cred')"))
  workspaceId           String    @map("workspace_id")
  connectionId          String    @unique @map("connection_id")
  accessTokenCiphertext Bytes     @map("access_token_ciphertext")
  accessTokenNonce      Bytes     @map("access_token_nonce")
  refreshTokenCiphertext Bytes?   @map("refresh_token_ciphertext")
  refreshTokenNonce     Bytes?    @map("refresh_token_nonce")
  algorithm             String    @default("aes-256-gcm")
  keyVersion            String    @map("key_version")
  wrappedDataKey        Bytes?    @map("wrapped_data_key")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastRefreshedAt       DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  lastRefreshError      String?   @map("last_refresh_error")
  rotatedAt             DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([accessTokenExpiresAt])
  @@map("social_credentials")
  @@schema("private")
}

/// Short lived. `state` is unpredictable, the redirect must match the exact
/// allowlist, and the row is consumed once.
model OAuthTransaction {
  id             String                  @id @default(dbgenerated("app.new_id('oauth')"))
  workspaceId    String                  @map("workspace_id")
  purpose        OAuthTransactionPurpose
  provider       ProviderKind?
  stateHash      String                  @unique @map("state_hash")
  codeChallenge  String?                 @map("code_challenge")
  codeChallengeMethod String?            @map("code_challenge_method")
  redirectUri    String                  @map("redirect_uri")
  requestedScopes String[]               @default([]) @map("requested_scopes")
  initiatedByUserId String?              @map("initiated_by_user_id")
  oauthClientId  String?                 @map("oauth_client_id")
  reconnectConnectionId String?          @map("reconnect_connection_id")
  consumedAt     DateTime?               @map("consumed_at") @db.Timestamptz(6)
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
  @@map("oauth_transactions")
  @@schema("private")
}

/// A third-party developer application registered in our own OAuth console.
model OAuthClient {
  id               String            @id @default(dbgenerated("app.new_id('app')"))
  workspaceId      String            @map("workspace_id")
  name             String
  clientId         String            @unique @map("client_id")
  clientType       OAuthClientType   @map("client_type")
  secretHash       String?           @map("secret_hash")
  secretRotatedAt  DateTime?         @map("secret_rotated_at") @db.Timestamptz(6)
  /// Exact match only. No wildcards, no prefix matching.
  redirectUris     String[]          @default([]) @map("redirect_uris")
  allowedScopes    String[]          @default([]) @map("allowed_scopes")
  homepageUrl      String?           @map("homepage_url")
  privacyPolicyUrl String?           @map("privacy_policy_url")
  termsUrl         String?           @map("terms_url")
  logoUrl          String?           @map("logo_url")
  status           OAuthClientStatus @default(sandbox)
  createdByUserId  String            @map("created_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants    OAuthGrant[]

  @@index([workspaceId])
  @@map("oauth_clients")
  @@schema("private")
}

model OAuthGrant {
  id                 String    @id @default(dbgenerated("app.new_id('grant')"))
  workspaceId        String    @map("workspace_id")
  oauthClientId      String    @map("oauth_client_id")
  subjectUserId      String    @map("subject_user_id")
  scopes             String[]  @default([])
  brandScope         String[]  @default([]) @map("brand_scope")
  connectionScope    String[]  @default([]) @map("connection_scope")
  refreshTokenHash   String?   @unique @map("refresh_token_hash")
  refreshTokenRotatedAt DateTime? @map("refresh_token_rotated_at") @db.Timestamptz(6)
  consentedAt        DateTime  @default(now()) @map("consented_at") @db.Timestamptz(6)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId    String?   @map("revoked_by_user_id")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@unique([oauthClientId, subjectUserId, workspaceId])
  @@index([workspaceId])
  @@index([subjectUserId])
  @@map("oauth_grants")
  @@schema("private")
}

/// Transactional handoff from a database commit to Temporal. A dispatcher
/// claims rows with SKIP LOCKED and every payload is independently idempotent.
model OutboxEvent {
  id             String    @id @default(dbgenerated("app.new_id('outbox')"))
  workspaceId    String    @map("workspace_id")
  kind           String
  dedupeKey      String    @map("dedupe_key")
  payload        Json
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastErrorCode  String?   @map("last_error_code")
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(6)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([availableAt, id])
  @@index([workspaceId])
  @@map("outbox")
  @@schema("private")
}

/// Immutable evidence for an outbox item that exhausted its dispatch budget.
model OutboxDeadLetter {
  id            String   @id @default(dbgenerated("app.new_id('outboxdl')"))
  workspaceId   String   @map("workspace_id")
  outboxEventId String   @unique @map("outbox_event_id")
  kind          String
  dedupeKey     String   @map("dedupe_key")
  payload       Json
  attempts      Int
  errorCode     String   @map("error_code")
  failedAt      DateTime @map("failed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, failedAt(sort: Desc)])
  @@map("outbox_dead_letter")
  @@schema("private")
}

model MediaAsset {
  id             String            @id @default(dbgenerated("app.new_id('media')"))
  workspaceId    String            @map("workspace_id")
  brandId        String?           @map("brand_id")
  kind           MediaKind
  storageBucket  String            @map("storage_bucket")
  storageKey     String            @map("storage_key")
  /// Sniffed from the bytes. The uploaded filename extension is not trusted.
  mimeType       String            @map("mime_type")
  byteSize       BigInt            @map("byte_size")
  checksumSha256 String            @map("checksum_sha256")
  width          Int?
  height         Int?
  durationMs     Int?              @map("duration_ms")
  frameRate      Float?            @map("frame_rate")
  altText        String?           @map("alt_text")
  altTextWaivedAt DateTime?        @map("alt_text_waived_at") @db.Timestamptz(6)
  altTextWaivedReason String?           @map("alt_text_waived_reason")
  altTextWaivedByName String?           @map("alt_text_waived_by_name")
  rights         RightsDeclaration @default(unverified)
  rightsNote     String?           @map("rights_note")
  /// Where the file came from, kept for provenance. An imported asset keeps the
  /// origin the source supplied.
  originKind     String            @default("upload") @map("origin_kind")
  originUrl      String?           @map("origin_url")
  scanState      MediaScanState    @default(pending) @map("scan_state")
  scanNote       String?           @map("scan_note")
  metadata       Json              @default("{}")
  createdByUserId String?          @map("created_by_user_id")
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)
  retentionExpiresAt  DateTime          @map("retention_expires_at") @db.Timestamptz(6)
  storageDeletedAt    DateTime?         @map("storage_deleted_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  derivatives MediaDerivative[]

  @@unique([workspaceId, checksumSha256])
  @@index([workspaceId])
  @@index([workspaceId, kind, createdAt(sort: Desc)])
  @@index([retentionExpiresAt, storageDeletedAt])
  @@map("media_assets")
  @@schema("app")
}

model MediaDerivative {
  id             String         @id @default(dbgenerated("app.new_id('mder')"))
  workspaceId    String         @map("workspace_id")
  mediaAssetId   String         @map("media_asset_id")
  kind           DerivativeKind
  provider       ProviderKind?
  presetKey      String         @map("preset_key")
  storageBucket  String         @map("storage_bucket")
  storageKey     String         @map("storage_key")
  mimeType       String         @map("mime_type")
  byteSize       BigInt         @map("byte_size")
  checksumSha256 String         @map("checksum_sha256")
  width          Int?
  height         Int?
  durationMs     Int?           @map("duration_ms")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, presetKey])
  @@index([workspaceId])
  @@map("media_derivatives")
  @@schema("app")
}

/// One durable unit of external work. `idempotencyKey` is unique per workspace
/// and `temporalWorkflowId` is deterministic, so a replay cannot create twice.
model PublishJob {
  id                  String       @id @default(dbgenerated("app.new_id('job')"))
  workspaceId         String       @map("workspace_id")
  contentItemId       String       @map("content_item_id")
  contentVersionId    String       @map("content_version_id")
  postVariantId       String?      @map("post_variant_id")
  commentThreadItemId String?      @map("comment_thread_item_id")
  connectionId        String       @map("connection_id")
  approvalRequestId   String?      @map("approval_request_id")
  approvalPolicy      ApprovalPolicy @default(none) @map("approval_policy")
  /// The instant that actually executes, always UTC.
  scheduledFor        DateTime     @map("scheduled_for") @db.Timestamptz(6)
  /// The zone the user chose, retained so a DST shift is explainable.
  scheduledTimeZone   String       @map("scheduled_time_zone")
  state               PublishState @default(scheduled)
  idempotencyKey      String       @map("idempotency_key")
  temporalWorkflowId  String?      @unique @map("temporal_workflow_id")
  temporalRunId       String?      @map("temporal_run_id")
  attemptCount        Int          @default(0) @map("attempt_count")
  nextAttemptAt       DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorClass      ErrorClass?  @map("last_error_class")
  lastErrorCode       String?      @map("last_error_code")
  surface             CreationSurface @default(web)
  dispatchedAt        DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  completedAt         DateTime?    @map("completed_at") @db.Timestamptz(6)
  canceledAt          DateTime?    @map("canceled_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem       ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVersion    ContentVersion     @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  postVariant       PostVariant?       @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  commentThreadItem CommentThreadItem? @relation(fields: [commentThreadItemId], references: [id], onDelete: Cascade)
  connection        SocialConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  approvalRequest   ApprovalRequest?   @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  attempts PublishAttempt[]
  receipt  PublicationReceipt?

  @@unique([workspaceId, idempotencyKey], map: "uq_publish_jobs_workspace_idempotency_key")
  @@index([workspaceId])
  // Queue sweep and calendar range query.
  @@index([workspaceId, scheduledFor, state])
  @@index([state, nextAttemptAt])
  @@index([workspaceId, connectionId, scheduledFor])
  @@map("publish_jobs")
  @@schema("app")
}

/// Always references the exact immutable content version that was sent. A
/// sanitized response only: no token, no full provider payload.
model PublishAttempt {
  id                String         @id @default(dbgenerated("app.new_id('att')"))
  workspaceId       String         @map("workspace_id")
  publishJobId      String         @map("publish_job_id")
  contentVersionId  String         @map("content_version_id")
  connectionId      String         @map("connection_id")
  attemptNumber     Int            @map("attempt_number")
  outcome           AttemptOutcome @default(pending)
  errorClass        ErrorClass?    @map("error_class")
  errorCode         String?        @map("error_code")
  /// Safe to show a user. Provider text is redacted before it lands here.
  sanitizedResponse Json           @default("{}") @map("sanitized_response")
  requestMetadata   Json           @default("{}") @map("request_metadata")
  providerRequestId String?        @map("provider_request_id")
  httpStatus        Int?           @map("http_status")
  startedAt         DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?      @map("ended_at") @db.Timestamptz(6)
  retryAfterSeconds Int?           @map("retry_after_seconds")
  costEstimateMinor Int?           @map("cost_estimate_minor")
  costActualMinor   Int?           @map("cost_actual_minor")
  costCurrency      String?        @map("cost_currency")
  correlationId     String?        @map("correlation_id")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishJob     PublishJob       @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  contentVersion ContentVersion   @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  connection     SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([publishJobId, attemptNumber])
  @@index([workspaceId])
  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([workspaceId, errorClass])
  @@map("publish_attempts")
  @@schema("app")
}

/// Immutable evidence that an external post exists. `0030_constraints.sql`
/// rejects UPDATE apart from the narrow analytics-sync bookkeeping columns.
/// "Published" requires an external ID or provider evidence, never a bare 2xx
/// from a media container step.
model PublicationReceipt {
  id               String       @id @default(dbgenerated("app.new_id('receipt')"))
  workspaceId      String       @map("workspace_id")
  publishJobId     String       @unique @map("publish_job_id")
  contentVersionId String       @map("content_version_id")
  connectionId     String       @map("connection_id")
  provider         ProviderKind
  externalPostId   String       @map("external_post_id")
  permalink        String?
  contentHash      String       @map("content_hash")
  mediaChecksums   String[]     @default([]) @map("media_checksums")
  /// The exact public short URLs that appeared in the published copy.
  publishedShortLinks String[]  @default([]) @map("published_short_links")
  publishedAt      DateTime     @map("published_at") @db.Timestamptz(6)
  dispatchedAt     DateTime?    @map("dispatched_at") @db.Timestamptz(6)
  scheduledFor     DateTime?    @map("scheduled_for") @db.Timestamptz(6)
  scheduledTimeZone String?     @map("scheduled_time_zone")
  surface          CreationSurface
  approvedByUserId String?      @map("approved_by_user_id")
  approvalPolicy   ApprovalPolicy @default(none) @map("approval_policy")
  costActualMinor  Int?         @map("cost_actual_minor")
  costCurrency     String?      @map("cost_currency")
  responseEvidence Json         @default("{}") @map("response_evidence")
  deletedExternallyAt DateTime? @map("deleted_externally_at") @db.Timestamptz(6)
  lastAnalyticsSyncAt DateTime? @map("last_analytics_sync_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishJob     PublishJob       @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
  contentVersion ContentVersion   @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  connection     SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  metricObservations MetricObservation[]

  @@unique([provider, externalPostId], map: "uq_publication_receipts_provider_external_post_id")
  @@index([workspaceId])
  @@index([workspaceId, publishedAt(sort: Desc)])
  @@index([workspaceId, connectionId, publishedAt(sort: Desc)])
  @@map("publication_receipts")
  @@schema("app")
}

model ProviderLimit {
  id            String       @id @default(dbgenerated("app.new_id('limit')"))
  workspaceId   String       @map("workspace_id")
  connectionId  String?      @map("connection_id")
  provider      ProviderKind
