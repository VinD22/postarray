// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model User {
  id             String     @id @default(dbgenerated("app.new_id('user')"))
  /// Neon Auth / Better Auth user id. Provider ids are opaque strings, while
  /// this row remains our profile and tenancy anchor.
  authSubjectId   String?    @unique @map("auth_subject_id")
  email          String     @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  displayName    String     @map("display_name")
  avatarUrl      String?    @map("avatar_url")
  status         UserStatus @default(active)
  locale         String     @default("en")
  timeZone       String     @default("UTC") @map("time_zone")
  mfaEnrolledAt  DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(6)
  lastSeenAt     DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  aliases     UserAlias[]
  memberships Membership[]
  sessions    UserSession[]
  consents    Consent[]

  @@index([status])
  @@map("users")
  @@schema("app")
}

/// A username is a verified alias onto an existing identity, never a credential
/// by itself. `normalizedHandle` is NFKC + conservative lowercase so confusables
/// collapse before the unique index is consulted.
model UserAlias {
  id               String    @id @default(dbgenerated("app.new_id('alias')"))
  userId           String    @map("user_id")
  handle           String
  normalizedHandle String    @unique @map("normalized_handle") @db.Citext
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  isPrimary        Boolean   @default(false) @map("is_primary")
  reservedReason   String?   @map("reserved_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_aliases")
  @@schema("app")
}

model Workspace {
  id              String          @id @default(dbgenerated("app.new_id('ws')"))
  name            String
  slug            String          @unique @db.Citext
  ownerUserId     String          @map("owner_user_id")
  status          WorkspaceStatus @default(trialing)
  defaultLocale   String          @default("en") @map("default_locale")
  defaultTimeZone String          @default("UTC") @map("default_time_zone")
  /// Set by an operator to stop every outbound provider call for this tenant.
  killSwitchAt    DateTime?       @map("kill_switch_at") @db.Timestamptz(6)
  killSwitchReason String?        @map("kill_switch_reason")
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             Membership[]
  rolePermissions         RolePermission[]
  serviceAccounts         ServiceAccount[]
  apiKeys                 ApiKey[]
  auditEvents             AuditEvent[]
  sessions                UserSession[]
  consents                Consent[]
  brands                  Brand[]
  businessProfiles        BusinessProfile[]
  brandSources            BrandSource[]
  glossaryTerms           GlossaryTerm[]
  campaigns               Campaign[]
  contentItems            ContentItem[]
  contentVersions         ContentVersion[]
  postVariants            PostVariant[]
  postingSets             PostingSet[]
  signatures              Signature[]
  providerDestinations    ProviderDestination[]
  mentionEntities         MentionEntity[]
  approvalRequests        ApprovalRequest[]
  approvalDecisions       ApprovalDecision[]
  commentThreadItems      CommentThreadItem[]
  growthPlans             GrowthPlan[]
  opportunityMatches      StrategyOpportunityMatch[]
  socialConnections       SocialConnection[]
  socialCredentials       SocialCredential[]
  oauthTransactions       OAuthTransaction[]
  oauthClients            OAuthClient[]
  oauthGrants             OAuthGrant[]
  outboxEvents            OutboxEvent[]
  outboxDeadLetters       OutboxDeadLetter[]
  mediaAssets             MediaAsset[]
  mediaDerivatives        MediaDerivative[]
  publishJobs             PublishJob[]
  publishAttempts         PublishAttempt[]
  publicationReceipts     PublicationReceipt[]
  providerLimits          ProviderLimit[]
  connectionIncidents     ConnectionIncident[]
  automationRules         AutomationRule[]
  automationRuleRuns      AutomationRuleRun[]
  rssFeeds                RssFeed[]
  rssFeedItems            RssFeedItem[]
  webhookEndpoints        WebhookEndpoint[]
  webhookDeliveries       WebhookDelivery[]
  metricObservations      MetricObservation[]
  analyticsSyncRuns       AnalyticsSyncRun[]
  experiments             Experiment[]
  insights                Insight[]
  shortLinks              ShortLink[]
  shortLinkClicks         ShortLinkClick[]
  polarCustomer           PolarCustomer?
  subscriptions           Subscription[]
  entitlements            Entitlement[]
  usageEvents             UsageEvent[]
  affiliatePartners       AffiliatePartner[]
  referralAttributions    ReferralAttribution[]
  commissionLedgerEntries CommissionLedger[]
  deletionRequests        DeletionRequest[]
  dataExports             DataExport[]

  @@index([ownerUserId])
  @@index([status])
  @@map("workspaces")
  @@schema("app")
}

model Membership {
  id            String          @id @default(dbgenerated("app.new_id('membership')"))
  workspaceId   String          @map("workspace_id")
  userId        String          @map("user_id")
  role          WorkspaceRole
  state         MembershipState @default(invited)
  /// Empty means "every brand in the workspace".
  brandScope    String[]        @default([]) @map("brand_scope")
  invitedByUserId String?       @map("invited_by_user_id")
  invitedAt     DateTime?       @map("invited_at") @db.Timestamptz(6)
  acceptedAt    DateTime?       @map("accepted_at") @db.Timestamptz(6)
  removedAt     DateTime?       @map("removed_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, role, state])
  @@map("memberships")
  @@schema("app")
}

/// Invitation bearer tokens are never stored. Only a SHA-256 digest is kept,
/// and accepting also requires ownership of the invited email address.
model Invitation {
  id              String          @id @default(dbgenerated("app.new_id('invitation')"))
  workspaceId     String          @map("workspace_id")
  email           String          @db.Citext
  role            WorkspaceRole
  note            String?
  tokenHash       String          @unique @map("token_hash")
  state           InvitationState @default(pending)
  invitedByUserId String          @map("invited_by_user_id")
  expiresAt       DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?       @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId])
  @@index([workspaceId, state, expiresAt])
  @@index([email, state])
  @@map("invitations")
  @@schema("private")
}

/// Built-in roles are code. This table stores per-workspace grants and denials
/// layered on top, which is what a future custom role becomes.
model RolePermission {
  id          String        @id @default(dbgenerated("app.new_id('roleperm')"))
  workspaceId String        @map("workspace_id")
  role        WorkspaceRole
  permission  String
  effect      String        @default("allow")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, permission])
  @@index([workspaceId])
  @@map("role_permissions")
  @@schema("app")
}

model ServiceAccount {
  id                  String   @id @default(dbgenerated("app.new_id('svc')"))
  workspaceId         String   @map("workspace_id")
  name                String
  description         String?
  scopes              String[] @default([])
  brandScope          String[] @default([]) @map("brand_scope")
  connectionScope     String[] @default([]) @map("connection_scope")
  providerScope       ProviderKind[] @default([]) @map("provider_scope")
  localeScope         String[] @default([]) @map("locale_scope")
  approvedDomains     String[] @default([]) @map("approved_domains")
  maxDailyPublishes   Int?     @map("max_daily_publishes")
  maxLookAheadDays    Int?     @map("max_look_ahead_days")
  /// 0 read, 1 draft, 2 schedule within preapproval, 3 human confirmation.
  maxApprovalLevel    Int      @default(1) @map("max_approval_level")
  disabledAt          DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdByUserId     String   @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("service_accounts")
  @@schema("app")
}

/// Only the hash is stored. `prefix` is the short public fragment shown in the
/// UI so a key can be identified without revealing it.
model ApiKey {
  id               String    @id @default(dbgenerated("app.new_id('key')"))
  workspaceId      String    @map("workspace_id")
  serviceAccountId String?   @map("service_account_id")
  name             String
  prefix           String    @unique
  secretHash       String    @map("secret_hash")
  hashAlgorithm    String    @default("argon2id") @map("hash_algorithm")
  scopes           String[]  @default([])
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([serviceAccountId])
  @@map("api_keys")
  @@schema("private")
}

/// Append only. `0040_audit.sql` installs a trigger that rejects UPDATE and
/// DELETE, including for the owner role.
model AuditEvent {
  id             String    @id @default(dbgenerated("app.new_id('aud')"))
  workspaceId    String    @map("workspace_id")
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id")
  /// Set when the action arrived through a third-party developer application.
  actorClientId  String?   @map("actor_client_id")
  surface        CreationSurface
  action         String
  targetType     String    @map("target_type")
  targetId       String?   @map("target_id")
  beforeHash     String?   @map("before_hash")
  afterHash      String?   @map("after_hash")
  /// Sanitized. Never a token, provider payload or raw request body.
  metadata       Json      @default("{}")
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent")
  correlationId  String?   @map("correlation_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Restrict, not Cascade. The audit log outlives the tenant: a workspace is
  /// soft deleted through `deletedAt`, and the row is only removed for real once
  /// the retention window has passed and `private.prune_audit_events()` has run.
  /// A cascade here would let deleting a workspace erase the evidence of what
  /// happened in it, which is precisely what an audit log exists to prevent.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, actorType, actorId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
  @@schema("private")
}

/// Session metadata only. The provider session secret lives in Neon Auth; this row
/// exists so a user can review and revoke devices and so privileged reads are
/// attributable.
model UserSession {
  id             String       @id @default(dbgenerated("app.new_id('session')"))
  userId         String       @map("user_id")
  workspaceId    String?      @map("workspace_id")
  state          SessionState @default(active)
  authMethod     String       @map("auth_method")
  mfaSatisfiedAt DateTime?    @map("mfa_satisfied_at") @db.Timestamptz(6)
  ipAddress      String?      @map("ip_address") @db.Inet
  userAgent      String?      @map("user_agent")
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, state])
  @@index([workspaceId])
  @@map("user_sessions")
  @@schema("private")
}

model Consent {
  id              String       @id @default(dbgenerated("app.new_id('consent')"))
  userId          String       @map("user_id")
  workspaceId     String?      @map("workspace_id")
  kind            ConsentKind
  state           ConsentState @default(granted)
  documentVersion String       @map("document_version")
  countryCode     String?      @map("country_code") @db.Char(2)
  grantedAt       DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt     DateTime?    @map("withdrawn_at") @db.Timestamptz(6)
  ipAddress       String?      @map("ip_address") @db.Inet
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, documentVersion])
  @@index([workspaceId])
  @@index([userId, kind])
  @@map("consents")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Brands and content
// ---------------------------------------------------------------------------

model Brand {
  id                  String   @id @default(dbgenerated("app.new_id('brand')"))
  workspaceId         String   @map("workspace_id")
  name                String
  slug                String   @db.Citext
  voice               String?
  audience            String?
  approvedClaims      String[] @default([]) @map("approved_claims")
  blockedTerms        String[] @default([]) @map("blocked_terms")
  localeRules         Json     @default("{}") @map("locale_rules")
  domains             String[] @default([])
  /// Default AI or paid-partnership disclosure appended where a platform
  /// requires one. Never silently applied without preview.
  disclosureDefaults  Json     @default("{}") @map("disclosure_defaults")
  defaultTimeZone     String?  @map("default_time_zone")
  defaultShortLinkOn  Boolean  @default(false) @map("default_short_link_on")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace            Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfiles     BusinessProfile[]
  brandSources         BrandSource[]
  glossaryTerms        GlossaryTerm[]
  campaigns            Campaign[]
  contentItems         ContentItem[]
  signatures           Signature[]
  postingSets          PostingSet[]
  socialConnections    SocialConnection[]
  growthPlans          GrowthPlan[]
  shortLinks           ShortLink[]
  automationRules      AutomationRule[]
  rssFeeds             RssFeed[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("brands")
  @@schema("app")
}

/// Versioned. A new revision never overwrites the confirmed one, because an
/// approved growth plan points at the exact profile version it was built from.
model BusinessProfile {
  id                 String    @id @default(dbgenerated("app.new_id('bprof')"))
  workspaceId        String    @map("workspace_id")
  brandId            String    @map("brand_id")
  version            Int       @default(1)
  /// What the thing being marketed is called. Required before a growth plan can
  /// be generated, so the plan can name the product rather than the brand.
  productName        String?   @map("product_name")
  productUrl         String?   @map("product_url")
  productUrlVerifiedAt DateTime? @map("product_url_verified_at") @db.Timestamptz(6)
  description        String?
  category           String?
  markets            String[]  @default([])
  languages          String[]  @default([])
  idealCustomer      String?   @map("ideal_customer")
  objective          String?
  conversionEvent    String?   @map("conversion_event")
  existingChannels   Json      @default("[]") @map("existing_channels")
  /// Facts the user explicitly confirmed. AI never promotes an inference here.
  provenClaims       Json      @default("[]") @map("proven_claims")
  prohibitedClaims   String[]  @default([]) @map("prohibited_claims")
  competitors        Json      @default("[]")
  weeklyCapacityHours Int?     @map("weekly_capacity_hours")
  constraints        String?
  /// 0-100. Drives the "missing information" warnings in a generated plan.
  completenessScore  Int       @default(0) @map("completeness_score")
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedByUserId  String?   @map("confirmed_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  growthPlans GrowthPlan[]

  @@unique([brandId, version])
  @@index([workspaceId])
  @@index([workspaceId, brandId, confirmedAt(sort: Desc)])
  @@map("business_profiles")
  @@schema("app")
}

model BrandSource {
  id            String             @id @default(dbgenerated("app.new_id('bsrc')"))
  workspaceId   String             @map("workspace_id")
  brandId       String             @map("brand_id")
  kind          BrandSourceKind
  label         String
  sourceUrl     String?            @map("source_url")
  storageKey    String?            @map("storage_key")
  checksum      String?
  byteSize      Int?               @map("byte_size")
  mimeType      String?            @map("mime_type")
  consentState  SourceConsentState @default(declared) @map("consent_state")
  /// Retrieved text is untrusted prompt input. It is delimited before it ever
  /// reaches a model and can never change tool policy.
  extractedText String?            @map("extracted_text")
  retrievedAt   DateTime?          @map("retrieved_at") @db.Timestamptz(6)
  createdByUserId String           @map("created_by_user_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, brandId])
  @@map("brand_sources")
  @@schema("app")
}

model GlossaryTerm {
  id                   String   @id @default(dbgenerated("app.new_id('term')"))
  workspaceId          String   @map("workspace_id")
  brandId              String   @map("brand_id")
  locale               String
  term                 String
  preferredTranslation String?  @map("preferred_translation")
  prohibitedTranslations String[] @default([]) @map("prohibited_translations")
  context              String?
  doNotTranslate       Boolean  @default(false) @map("do_not_translate")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale, term])
  @@index([workspaceId])
  @@map("glossary_terms")
  @@schema("app")
}

model Campaign {
  id             String    @id @default(dbgenerated("app.new_id('campaign')"))
  workspaceId    String    @map("workspace_id")
  brandId        String    @map("brand_id")
  name           String
  objective      String?
  tags           String[]  @default([])
  utmDefaults    Json      @default("{}") @map("utm_defaults")
  startsAt       DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime? @map("ends_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdByUserId String   @map("created_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  experiments  Experiment[]
  shortLinks   ShortLink[]

  @@index([workspaceId])
  @@index([workspaceId, brandId])
  @@map("campaigns")
  @@schema("app")
}

/// The canonical idea. Copy lives in immutable `ContentVersion` rows; per-target
/// output lives in `PostVariant`.
model ContentItem {
  id               String          @id @default(dbgenerated("app.new_id('content')"))
  workspaceId      String          @map("workspace_id")
  brandId          String          @map("brand_id")
  campaignId       String?         @map("campaign_id")
  postingSetId     String?         @map("posting_set_id")
  title            String?
  brief            String?
  state            PublishState    @default(draft)
  approvalPolicy   ApprovalPolicy  @default(none) @map("approval_policy")
  currentVersionId String?         @unique @map("current_version_id")
  approvedVersionId String?        @map("approved_version_id")
  /// Wall-clock intent plus its zone. The UTC instant lives on `PublishJob`.
  scheduledAt      DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  scheduledTimeZone String?        @map("scheduled_time_zone")
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz(6)
  publishedAt      DateTime?       @map("published_at") @db.Timestamptz(6)
  canceledAt       DateTime?       @map("canceled_at") @db.Timestamptz(6)
  /// Repeat cadence in days: 1, 2, 3, 4, 5, 6, 7, 14 or 30. Null means once.
  repeatEveryDays  Int?            @map("repeat_every_days")
  repeatUntil      DateTime?       @map("repeat_until") @db.Timestamptz(6)
  repeatCount      Int?            @map("repeat_count")
  repeatOfItemId   String?         @map("repeat_of_item_id")
  surface          CreationSurface @default(web)
  creationMethod   CreationMethod  @default(human) @map("creation_method")
  createdByUserId  String?         @map("created_by_user_id")
  createdByServiceAccountId String? @map("created_by_service_account_id")
  correlationId    String?         @map("correlation_id")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  postingSet     PostingSet?     @relation(fields: [postingSetId], references: [id], onDelete: SetNull)
  currentVersion ContentVersion? @relation("ContentItemCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions         ContentVersion[]  @relation("ContentItemVersions")
  variants         PostVariant[]
  approvalRequests ApprovalRequest[]
  publishJobs      PublishJob[]
  insights         Insight[]

  @@index([workspaceId])
  // Calendar range query: one workspace, a date window, filtered by state.
  @@index([workspaceId, scheduledAt, state])
  @@index([workspaceId, brandId, state])
  @@index([workspaceId, campaignId])
  @@index([repeatOfItemId])
  @@map("content_items")
  @@schema("app")
}

/// Immutable. `0030_constraints.sql` installs a trigger that rejects UPDATE.
/// Every publish attempt references exactly one of these rows.
model ContentVersion {
  id             String         @id @default(dbgenerated("app.new_id('cver')"))
  workspaceId    String         @map("workspace_id")
  contentItemId  String         @map("content_item_id")
  version        Int
  body           String
  /// The canonical master payload: blocks, media references, link decisions,
  /// applied signature and frozen short URLs.
  payload        Json           @default("{}")
  /// SHA-256 over the canonicalized payload. Copied onto every receipt.
  contentHash    String         @map("content_hash")
  locale         String         @default("en")
  creationMethod CreationMethod @default(human) @map("creation_method")
  aiModel        String?        @map("ai_model")
  aiPromptVersion String?       @map("ai_prompt_version")
  sourceIds      String[]       @default([]) @map("source_ids")
  createdByUserId String?       @map("created_by_user_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation("ContentItemVersions", fields: [contentItemId], references: [id], onDelete: Cascade)

  currentOf        ContentItem?         @relation("ContentItemCurrentVersion")
  variants         PostVariant[]
  approvalRequests ApprovalRequest[]
  publishJobs      PublishJob[]
  publishAttempts  PublishAttempt[]
  receipts         PublicationReceipt[]

  @@unique([contentItemId, version])
  @@index([workspaceId])
  @@index([workspaceId, contentHash])
  @@map("content_versions")
  @@schema("app")
}

/// One platform target. `inheritedFields` records what still tracks the master
/// so the composer can show inherited versus overridden without guessing.
model PostVariant {
  id               String       @id @default(dbgenerated("app.new_id('pv')"))
  workspaceId      String       @map("workspace_id")
  contentItemId    String       @map("content_item_id")
  contentVersionId String       @map("content_version_id")
  connectionId     String       @map("connection_id")
  destinationId    String?      @map("destination_id")
  provider         ProviderKind
  locale           String       @default("en")
  body             String
  /// Provider-specific settings: privacy, comment/duet/stitch toggles, title,
  /// description, thumbnail choice, category, alt text.
  settings         Json         @default("{}")
  mediaAssetIds    String[]     @default([]) @map("media_asset_ids")
  mentionEntityIds String[]     @default([]) @map("mention_entity_ids")
  signatureId      String?      @map("signature_id")
  inheritedFields  String[]     @default([]) @map("inherited_fields")
  overriddenFields String[]     @default([]) @map("overridden_fields")
  state            PublishState @default(draft)
  /// Snapshot of the capability contract used at approval, revalidated
  /// immediately before dispatch.
  capabilitySnapshotVersion String? @map("capability_snapshot_version")
  validationIssues Json         @default("[]") @map("validation_issues")
  /// Integer minor units of `estimatedCostCurrency`. X charges per operation and
  /// a post containing a URL costs materially more.
  estimatedCostMinor Int?       @map("estimated_cost_minor")
  estimatedCostCurrency String? @map("estimated_cost_currency")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem    ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVersion ContentVersion       @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)
  connection     SocialConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  destination    ProviderDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  signature      Signature?           @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  commentItems CommentThreadItem[]
  publishJobs  PublishJob[]

  @@unique([contentVersionId, connectionId])
  @@index([workspaceId])
  @@index([workspaceId, connectionId, state])
  @@index([contentItemId])
  @@map("post_variants")
  @@schema("app")
}

/// A reusable multi-platform group of targets, defaults and follow-up skeletons.
/// Applying a Set produces an independent draft; later Set edits never rewrite
/// an approved or scheduled post.
model PostingSet {
  id              String   @id @default(dbgenerated("app.new_id('set')"))
  workspaceId     String   @map("workspace_id")
  brandId         String   @map("brand_id")
  name            String
  description     String?
  connectionIds   String[] @default([]) @map("connection_ids")
  /// Per-provider placeholder copy, media placement rules and settings.
  targetDefaults  Json     @default("{}") @map("target_defaults")
  commentSkeleton Json     @default("[]") @map("comment_skeleton")
  signatureId     String?  @map("signature_id")
  approvalPolicy  ApprovalPolicy @default(none) @map("approval_policy")
  slotBehavior    String   @default("next_free_slot") @map("slot_behavior")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  signature Signature? @relation(fields: [signatureId], references: [id], onDelete: SetNull)

  contentItems ContentItem[]

  @@unique([workspaceId, brandId, name])
  @@index([workspaceId])
  @@map("posting_sets")
  @@schema("app")
}

model Signature {
  id           String        @id @default(dbgenerated("app.new_id('sig')"))
  workspaceId  String        @map("workspace_id")
  brandId      String        @map("brand_id")
  name         String
  body         String
  locale       String        @default("en")
  providers    ProviderKind[] @default([])
  autoApply    Boolean       @default(false) @map("auto_apply")
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  postVariants PostVariant[]
  postingSets  PostingSet[]

  @@unique([workspaceId, brandId, name, locale])
  @@index([workspaceId])
  @@map("signatures")
  @@schema("app")
}

/// Communities, boards, groups, organizations, Pages, channels and publications
/// discovered through the provider API for one connection.
model ProviderDestination {
  id                 String          @id @default(dbgenerated("app.new_id('dest')"))
  workspaceId        String          @map("workspace_id")
  connectionId       String          @map("connection_id")
  provider           ProviderKind
  kind               DestinationKind
  externalId         String          @map("external_id")
  displayName        String          @map("display_name")
  permalink          String?
  canPublish         Boolean         @default(true) @map("can_publish")
  metadata           Json            @default("{}")
  refreshedAt        DateTime        @default(now()) @map("refreshed_at") @db.Timestamptz(6)
  staleAfter         DateTime?       @map("stale_after") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  postVariants PostVariant[]

  @@unique([connectionId, kind, externalId])
  @@index([workspaceId])
  @@index([workspaceId, connectionId, kind])
  @@map("provider_destinations")
  @@schema("app")
}

/// A resolved provider entity. A plain display string is never published as a
/// native tag; without a resolved `externalId` the composer falls back to plain
/// text and says so.
model MentionEntity {
  id           String            @id @default(dbgenerated("app.new_id('mention')"))
  workspaceId  String            @map("workspace_id")
  connectionId String            @map("connection_id")
  provider     ProviderKind
  kind         MentionEntityKind
  externalId   String            @map("external_id")
  handle       String?
  displayLabel String            @map("display_label")
  avatarUrl    String?           @map("avatar_url")
  resolvedAt   DateTime          @default(now()) @map("resolved_at") @db.Timestamptz(6)
  expiresAt    DateTime?         @map("expires_at") @db.Timestamptz(6)
  metadata     Json              @default("{}")

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, provider, externalId])
  @@index([workspaceId])
  @@index([workspaceId, provider, handle])
  @@map("mention_entities")
  @@schema("app")
}

model ApprovalRequest {
  id               String        @id @default(dbgenerated("app.new_id('approval')"))
  workspaceId      String        @map("workspace_id")
  contentItemId    String        @map("content_item_id")
  contentVersionId String        @map("content_version_id")
  policy           ApprovalPolicy
  state            ApprovalState @default(pending)
  requestedByUserId String?      @map("requested_by_user_id")
  requestedByServiceAccountId String? @map("requested_by_service_account_id")
  assignedUserIds  String[]      @default([]) @map("assigned_user_ids")
  note             String?
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  /// Set the moment the request reaches `approved`. `0030_constraints.sql`
  /// rejects a publish job whose scheduled instant precedes this.
  resolvedAt       DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem    ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVersion ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  decisions   ApprovalDecision[]
  publishJobs PublishJob[]

  @@index([workspaceId])
  @@index([workspaceId, state, dueAt])
  @@index([contentItemId])
  @@map("approval_requests")
  @@schema("app")
}

model ApprovalDecision {
  id                String               @id @default(dbgenerated("app.new_id('apdecision')"))
  workspaceId       String               @map("workspace_id")
  approvalRequestId String               @map("approval_request_id")
  decision          ApprovalDecisionKind
  decidedByUserId   String               @map("decided_by_user_id")
  comment           String?
  /// Hash of the exact version the approver saw. If it differs at dispatch the
  /// job stops and reapproval is required.
  reviewedContentHash String             @map("reviewed_content_hash")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([approvalRequestId, createdAt])
  @@map("approval_decisions")
  @@schema("app")
}

/// A first comment or an ordered thread segment. A failed segment never
/// retroactively fails the root post that already published.
model CommentThreadItem {
  id             String       @id @default(dbgenerated("app.new_id('cmt')"))
  workspaceId    String       @map("workspace_id")
  postVariantId  String       @map("post_variant_id")
  position       Int
  body           String
  mediaAssetIds  String[]     @default([]) @map("media_asset_ids")
  /// Presets are 1, 2, 5, 10, 15, 30, 60 and 120 minutes, or a custom value.
  delayMinutes   Int          @default(0) @map("delay_minutes")
  /// A follow-up may be authored by a different owned connection where the
  /// provider allows it.
  authorConnectionId String?  @map("author_connection_id")
  state          PublishState @default(draft)
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postVariant PostVariant @relation(fields: [postVariantId], references: [id], onDelete: Cascade)

  publishJobs PublishJob[]

  @@unique([postVariantId, position])
  @@index([workspaceId])
  @@map("comment_thread_items")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Growth advisor
// ---------------------------------------------------------------------------

/// The versioned `GrowthPlan` document. `sections` holds the nine required
/// sections validated against one schema shared by UI, API, MCP and exports.
model GrowthPlan {
  id                String          @id @default(dbgenerated("app.new_id('plan')"))
  workspaceId       String          @map("workspace_id")
  brandId           String          @map("brand_id")
  businessProfileId String          @map("business_profile_id")
  version           Int             @default(1)
  state             GrowthPlanState @default(draft)
  objective         String?
  schemaVersion     String          @default("1") @map("schema_version")
  sections          Json            @default("{}")
  channelPriorities Json            @default("[]") @map("channel_priorities")
  contentPillars    Json            @default("[]") @map("content_pillars")
  cadence           Json            @default("{}")
  ugcPlan           Json            @default("{}") @map("ugc_plan")
  measurementPlan   Json            @default("{}") @map("measurement_plan")
  risksAndUnknowns  Json            @default("[]") @map("risks_and_unknowns")
  aiModel           String?         @map("ai_model")
  aiPromptVersion   String?         @map("ai_prompt_version")
  evidenceIds       String[]        @default([]) @map("evidence_ids")
  supersededByPlanId String?        @map("superseded_by_plan_id")
  approvedAt        DateTime?       @map("approved_at") @db.Timestamptz(6)
  approvedByUserId  String?         @map("approved_by_user_id")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Restrict)

  opportunityMatches StrategyOpportunityMatch[]

  @@unique([brandId, version])
  @@index([workspaceId])
  @@index([workspaceId, state])
  @@map("growth_plans")
  @@schema("app")
}

/// Operator-curated and global, not tenant owned. Readable by any authenticated
/// user only while `state = active`; writes are service-role only.
model GrowthOpportunity {
  id              String          @id @default(dbgenerated("app.new_id('opp')"))
  kind            OpportunityKind
  name            String
  officialUrl     String          @map("official_url")
  description     String?
  audience        String?
  regions         String[]        @default([])
  categories      String[]        @default([])
  /// How a submission is actually made. Never automated by us.
  submissionMethod String         @map("submission_method")
  submissionRules String?         @map("submission_rules")
  /// Integer minor units. Zero means free to submit.
  costMinor       Int             @default(0) @map("cost_minor")
  costCurrency    String          @default("USD") @map("cost_currency")
  disclosureRules String?         @map("disclosure_rules")
  selfPromotionAllowed Boolean    @default(false) @map("self_promotion_allowed")
  sourceNote      String?         @map("source_note")
  state           CatalogState    @default(draft)
  lastVerifiedAt  DateTime?       @map("last_verified_at") @db.Timestamptz(6)
  nextReviewAt    DateTime?       @map("next_review_at") @db.Timestamptz(6)
  verifiedByUserId String?        @map("verified_by_user_id")
  changeLog       Json            @default("[]") @map("change_log")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  matches StrategyOpportunityMatch[]

  @@unique([officialUrl])
  @@index([state, kind])
  @@index([state, lastVerifiedAt])
  @@map("growth_opportunities")
  @@schema("app")
}

/// A suggestion. Never a promised backlink, ranking or placement.
model StrategyOpportunityMatch {
  id            String        @id @default(dbgenerated("app.new_id('oppmatch')"))
  workspaceId   String        @map("workspace_id")
  growthPlanId  String        @map("growth_plan_id")
  opportunityId String        @map("opportunity_id")
  rank          Int
  fitExplanation String       @map("fit_explanation")
  suggestedAsset String?      @map("suggested_asset")
  suggestedPitch String?      @map("suggested_pitch")
  estimatedEffort String?     @map("estimated_effort")
  evidenceIds   String[]      @default([]) @map("evidence_ids")
  decision      MatchDecision @default(proposed)
  decidedByUserId String?     @map("decided_by_user_id")
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(6)
  outcomeNote   String?       @map("outcome_note")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  growthPlan  GrowthPlan        @relation(fields: [growthPlanId], references: [id], onDelete: Cascade)
  opportunity GrowthOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@unique([growthPlanId, opportunityId])
  @@index([workspaceId])
  @@index([workspaceId, decision])
  @@map("strategy_opportunity_matches")
  @@schema("app")
}

/// Operator-curated and global. The Creative Tool Radar may only recommend rows
/// from here, and shows `lastVerifiedAt` rather than guessing when it is stale.
model ToolCatalogEntry {
  id             String       @id @default(dbgenerated("app.new_id('tool')"))
  name           String
  officialUrl    String       @map("official_url")
  category       ToolCategory
  summary        String
  useCases       String[]     @default([]) @map("use_cases")
  inputs         String[]     @default([])
  outputs        String[]     @default([])
  priceModel     String       @map("price_model")
  priceNote      String?      @map("price_note")
  rightsCaveats  String?      @map("rights_caveats")
  privacyCaveats String?      @map("privacy_caveats")
  limitations    String?
  integrations   String[]     @default([])
  isAffiliate    Boolean      @default(false) @map("is_affiliate")
  affiliateDisclosure String?  @map("affiliate_disclosure")
  state          CatalogState @default(draft)
  lastVerifiedAt DateTime?    @map("last_verified_at") @db.Timestamptz(6)
  nextReviewAt   DateTime?    @map("next_review_at") @db.Timestamptz(6)
