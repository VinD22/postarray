  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, state, detectedAt(sort: Desc)])
  @@map("connection_incidents")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

/// Our policy-aware replacement for Plugs. A rule can never activate a
/// disallowed platform action; the policy check runs at save and at every run.
model AutomationRule {
  id              String              @id @default(dbgenerated("app.new_id('rule')"))
  workspaceId     String              @map("workspace_id")
  brandId         String              @map("brand_id")
  name            String
  state           AutomationRuleState @default(draft)
  /// When [trigger], if [conditions], then [actions], after [delay], until [end].
  trigger         Json                @default("{}")
  conditions      Json                @default("[]")
  actions         Json                @default("[]")
  delaySeconds    Int                 @default(0) @map("delay_seconds")
  endCondition    Json                @default("{}") @map("end_condition")
  /// Engagement-threshold rules require a window, cooldown and execution cap.
  measurementWindowSeconds Int?       @map("measurement_window_seconds")
  cooldownSeconds Int?                @map("cooldown_seconds")
  maxExecutions   Int?                @map("max_executions")
  executionCount  Int                 @default(0) @map("execution_count")
  runOncePerSource Boolean            @default(true) @map("run_once_per_source")
  skipWhenMetricStale Boolean         @default(true) @map("skip_when_metric_stale")
  requiresApproval Boolean            @default(true) @map("requires_approval")
  preauthorizedConnectionIds String[] @default([]) @map("preauthorized_connection_ids")
  version         Int                 @default(1)
  lastRunAt       DateTime?           @map("last_run_at") @db.Timestamptz(6)
  pausedReason    String?             @map("paused_reason")
  createdByUserId String              @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  runs AutomationRuleRun[]

  @@unique([workspaceId, brandId, name])
  @@index([workspaceId])
  @@index([workspaceId, state])
  @@map("automation_rules")
  @@schema("app")
}

model AutomationRuleRun {
  id               String   @id @default(dbgenerated("app.new_id('rulerun')"))
  workspaceId      String   @map("workspace_id")
  automationRuleId String   @map("automation_rule_id")
  ruleVersion      Int      @map("rule_version")
  state            RunState @default(pending)
  isTest           Boolean  @default(false) @map("is_test")
  /// Deduplication anchor: the post, feed item or webhook that triggered this.
  sourceKind       String   @map("source_kind")
  sourceId         String?  @map("source_id")
  triggerPayload   Json     @default("{}") @map("trigger_payload")
  evaluatedConditions Json  @default("[]") @map("evaluated_conditions")
  performedActions Json     @default("[]") @map("performed_actions")
  blockedReason    String?  @map("blocked_reason")
  errorClass       ErrorClass? @map("error_class")
  errorCode        String?  @map("error_code")
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  correlationId    String?  @map("correlation_id")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationRule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@unique([automationRuleId, sourceKind, sourceId])
  @@index([workspaceId])
  @@index([workspaceId, automationRuleId, startedAt(sort: Desc)])
  @@map("automation_rule_runs")
  @@schema("app")
}

model RssFeed {
  id                String     @id @default(dbgenerated("app.new_id('rss')"))
  workspaceId       String     @map("workspace_id")
  brandId           String     @map("brand_id")
  title             String
  feedUrl           String     @map("feed_url")
  health            FeedHealth @default(healthy)
  /// SSRF-safe fetch only: HTTP(S) scheme, DNS and IP checks before and after
  /// every redirect, private ranges denied, size and time limits.
  connectionIds     String[]   @default([]) @map("connection_ids")
  /// draft, approval, next_free_slot, fixed_cadence or immediate.
  publishPolicy     String     @default("draft") @map("publish_policy")
  templateBody      String?    @map("template_body")
  useAiAdaptation   Boolean    @default(false) @map("use_ai_adaptation")
  markCurrentAsSeen Boolean    @default(true) @map("mark_current_as_seen")
  pollIntervalSeconds Int      @default(900) @map("poll_interval_seconds")
  lastPolledAt      DateTime?  @map("last_polled_at") @db.Timestamptz(6)
  lastNewItemAt     DateTime?  @map("last_new_item_at") @db.Timestamptz(6)
  lastError         String?    @map("last_error")
  pausedAt          DateTime?  @map("paused_at") @db.Timestamptz(6)
  createdByUserId   String     @map("created_by_user_id")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  items RssFeedItem[]

  @@unique([workspaceId, feedUrl])
  @@index([workspaceId])
  @@index([health, lastPolledAt])
  @@map("rss_feeds")
  @@schema("app")
}

model RssFeedItem {
  id            String       @id @default(dbgenerated("app.new_id('rssitem')"))
  workspaceId   String       @map("workspace_id")
  rssFeedId     String       @map("rss_feed_id")
  /// GUID, link and content are all fingerprinted so the same item never
  /// republishes because a feed rewrote one field.
  guid          String
  fingerprint   String
  link          String?
  title         String?
  summary       String?
  imageUrl      String?      @map("image_url")
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  state         RssItemState @default(seen)
  contentItemId String?      @map("content_item_id")
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rssFeed   RssFeed   @relation(fields: [rssFeedId], references: [id], onDelete: Cascade)

  @@unique([rssFeedId, fingerprint])
  @@index([workspaceId])
  @@index([workspaceId, rssFeedId, createdAt(sort: Desc)])
  @@map("rss_feed_items")
  @@schema("app")
}

/// Holds a signing secret, so it lives in `private`.
model WebhookEndpoint {
  id               String               @id @default(dbgenerated("app.new_id('whep')"))
  workspaceId      String               @map("workspace_id")
  name             String
  url              String
  state            WebhookEndpointState @default(active)
  secretCiphertext Bytes                @map("secret_ciphertext")
  secretNonce      Bytes                @map("secret_nonce")
  keyVersion       String               @map("key_version")
  secretRotatedAt  DateTime?            @map("secret_rotated_at") @db.Timestamptz(6)
  subscribedEvents String[]             @default([]) @map("subscribed_events")
  brandScope       String[]             @default([]) @map("brand_scope")
  connectionScope  String[]             @default([]) @map("connection_scope")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  disabledReason   String?              @map("disabled_reason")
  createdByUserId  String               @map("created_by_user_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("webhook_endpoints")
  @@schema("private")
}

model WebhookDelivery {
  id                String               @id @default(dbgenerated("app.new_id('whd')"))
  workspaceId       String               @map("workspace_id")
  webhookEndpointId String               @map("webhook_endpoint_id")
  eventId           String               @map("event_id")
  eventType         String               @map("event_type")
  state             WebhookDeliveryState @default(pending)
  attemptCount      Int                  @default(0) @map("attempt_count")
  payloadHash       String               @map("payload_hash")
  signatureVersion  String               @default("v1") @map("signature_version")
  responseStatus    Int?                 @map("response_status")
  responseSnippet   String?              @map("response_snippet")
  nextAttemptAt     DateTime?            @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt       DateTime?            @map("delivered_at") @db.Timestamptz(6)
  deadLetteredAt    DateTime?            @map("dead_lettered_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, eventId])
  @@index([workspaceId])
  @@index([state, nextAttemptAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
  @@schema("private")
}

// ---------------------------------------------------------------------------
// Analytics, experiments and links
// ---------------------------------------------------------------------------

/// Global reference data. The provider's own field name and definition are kept
/// verbatim so a normalized label never hides an incompatible denominator.
model MetricDefinition {
  id                 String             @id @default(dbgenerated("app.new_id('metric')"))
  provider           ProviderKind
  providerFieldName  String             @map("provider_field_name")
  providerDefinition String             @map("provider_definition")
  normalizedName     String             @map("normalized_name")
  unit               MetricUnit
  availability       MetricAvailability @default(available)
  aggregationRule    AggregationRule    @default(latest_snapshot) @map("aggregation_rule")
  /// Some providers forbid deriving or combining their metrics. When true the
  /// value is displayed alone and excluded from comparisons.
  derivationRestricted Boolean          @default(false) @map("derivation_restricted")
  denominatorNote    String?            @map("denominator_note")
  appliesToAccount   Boolean            @default(false) @map("applies_to_account")
  appliesToPost      Boolean            @default(true) @map("applies_to_post")
  documentationUrl   String?            @map("documentation_url")
  lastVerifiedAt     DateTime?          @map("last_verified_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  observations MetricObservation[]

  @@unique([provider, providerFieldName])
  @@index([provider, normalizedName])
  @@map("metric_definitions")
  @@schema("app")
}

/// A missing permission or unsupported metric is stored with a null `rawValue`
/// and an explicit `availability`. It is never written as zero.
model MetricObservation {
  id                 String             @id @default(dbgenerated("app.new_id('observation')"))
  workspaceId        String             @map("workspace_id")
  metricDefinitionId String             @map("metric_definition_id")
  receiptId          String?            @map("receipt_id")
  connectionId       String             @map("connection_id")
  provider           ProviderKind
  externalPostId     String?            @map("external_post_id")
  observedAt         DateTime           @map("observed_at") @db.Timestamptz(6)
  /// Numeric(20,4): counts, ratios and seconds share one column without float
  /// rounding surprises.
  rawValue           Decimal?           @map("raw_value") @db.Decimal(20, 4)
  normalizedValue    Decimal?           @map("normalized_value") @db.Decimal(20, 4)
  availability       MetricAvailability @default(available)
  unavailableReason  String?            @map("unavailable_reason")
  /// Hash of the provider response this value came from, for auditability.
  sourceResponseHash String?            @map("source_response_hash")
  syncRunId          String?            @map("sync_run_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metricDefinition MetricDefinition    @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  receipt          PublicationReceipt? @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  connection       SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncRun          AnalyticsSyncRun?   @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([receiptId, metricDefinitionId, observedAt])
  @@index([workspaceId])
  @@index([receiptId, observedAt(sort: Desc)])
  @@index([workspaceId, connectionId, observedAt(sort: Desc)])
  @@map("metric_observations")
  @@schema("app")
}

model AnalyticsSyncRun {
  id            String       @id @default(dbgenerated("app.new_id('sync')"))
  workspaceId   String       @map("workspace_id")
  connectionId  String       @map("connection_id")
  provider      ProviderKind
  state         RunState     @default(pending)
  scope         String
  cursor        String?
  windowStart   DateTime?    @map("window_start") @db.Timestamptz(6)
  windowEnd     DateTime?    @map("window_end") @db.Timestamptz(6)
  receiptsCovered Int        @default(0) @map("receipts_covered")
  observationsWritten Int    @default(0) @map("observations_written")
  errorClass    ErrorClass?  @map("error_class")
  errorCode     String?      @map("error_code")
  providerCostMinor Int?     @map("provider_cost_minor")
  costCurrency  String?      @map("cost_currency")
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?    @map("ended_at") @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  observations MetricObservation[]

  @@index([workspaceId])
  @@index([workspaceId, connectionId, startedAt(sort: Desc)])
  @@map("analytics_sync_runs")
  @@schema("app")
}

/// Tagged before publishing so analysis is not entirely post hoc.
model Experiment {
  id            String          @id @default(dbgenerated("app.new_id('exp')"))
  workspaceId   String          @map("workspace_id")
  campaignId    String?         @map("campaign_id")
  name          String
  hypothesis    String
  variants      Json            @default("[]")
  successMetric String          @map("success_metric")
  windowStart   DateTime        @map("window_start") @db.Timestamptz(6)
  windowEnd     DateTime        @map("window_end") @db.Timestamptz(6)
  state         ExperimentState @default(planned)
  /// Sample size, confounders and comparability warnings. Association is never
  /// reported as causation.
  caveats       String?
  conclusion    String?
  createdByUserId String        @map("created_by_user_id")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  insights Insight[]

  @@index([workspaceId])
  @@index([workspaceId, state, windowStart])
  @@map("experiments")
  @@schema("app")
}

model Insight {
  id            String       @id @default(dbgenerated("app.new_id('insight')"))
  workspaceId   String       @map("workspace_id")
  contentItemId String?      @map("content_item_id")
  experimentId  String?      @map("experiment_id")
  /// A stable i18n key plus its ICU arguments. No English lives in this table.
  messageKey    String       @map("message_key")
  messageArgs   Json         @default("{}") @map("message_args")
  evidenceIds   String[]     @default([]) @map("evidence_ids")
  /// low, moderate or high. Wording, never a fabricated probability.
  confidence    String       @default("low")
  sampleSize    Int?         @map("sample_size")
  state         InsightState @default(new)
  aiModel       String?      @map("ai_model")
  aiPromptVersion String?    @map("ai_prompt_version")
  decidedByUserId String?    @map("decided_by_user_id")
  decidedAt     DateTime?    @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  experiment  Experiment?  @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, state, createdAt(sort: Desc)])
  @@map("insights")
  @@schema("app")
}

/// First-party redirect measurement. Deliberately a different data series from
/// provider-reported link clicks; neither substitutes for the other.
model ShortLink {
  id             String         @id @default(dbgenerated("app.new_id('lnk')"))
  workspaceId    String         @map("workspace_id")
  brandId        String?        @map("brand_id")
  campaignId     String?        @map("campaign_id")
  /// Null means the default isolated redirect domain.
  domain         String?
  slug           String
  destinationUrl String         @map("destination_url")
  utmParameters  Json           @default("{}") @map("utm_parameters")
  state          ShortLinkState @default(active)
  /// Result of the safety scan: open redirect, private network target,
  /// executable scheme, known abuse. Blocked links never resolve.
  safetyScan     Json           @default("{}") @map("safety_scan")
  safetyScannedAt DateTime?     @map("safety_scanned_at") @db.Timestamptz(6)
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz(6)
  disabledAt     DateTime?      @map("disabled_at") @db.Timestamptz(6)
  /// Every destination change is an audited action and never rewrites history.
  destinationHistory Json       @default("[]") @map("destination_history")
  createdByUserId String        @map("created_by_user_id")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  clicks ShortLinkClick[]

  @@unique([domain, slug], map: "uq_short_links_domain_slug")
  @@index([workspaceId])
  @@index([workspaceId, state, createdAt(sort: Desc)])
  @@map("short_links")
  @@schema("app")
}

/// No raw IP column. `dedupeKey` is a keyed hash with a short retention window,
/// which is enough for bot classification and deduplication and nothing more.
model ShortLinkClick {
  id             String            @id @default(dbgenerated("app.new_id('click')"))
  workspaceId    String            @map("workspace_id")
  shortLinkId    String            @map("short_link_id")
  /// Truncated to the hour.
  occurredAt     DateTime          @map("occurred_at") @db.Timestamptz(6)
  countryCode    String?           @map("country_code")
  deviceClass    String?           @map("device_class")
  referrerClass  String?           @map("referrer_class")
  botClass       BotClassification @default(unknown) @map("bot_class")
  dedupeKey      String            @map("dedupe_key")
  dedupeExpiresAt DateTime         @map("dedupe_expires_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@unique([shortLinkId, dedupeKey])
  @@index([workspaceId])
  @@index([shortLinkId, occurredAt])
  @@index([dedupeExpiresAt])
  @@map("short_link_clicks")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model PolarCustomer {
  id               String   @id @default(dbgenerated("app.new_id('customer')"))
  workspaceId      String   @unique @map("workspace_id")
  polarCustomerId  String   @unique @map("polar_customer_id")
  billingEmail     String   @map("billing_email") @db.Citext
  portalUrl        String?  @map("portal_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("polar_customers")
  @@schema("private")
}

/// Entitlement is driven from verified Polar state, never from a success
/// redirect. Both intervals carry a seven-day trial that charges zero at
/// checkout and converts only if the customer has not canceled.
model Subscription {
  id                 String             @id @default(dbgenerated("app.new_id('sub')"))
  workspaceId        String             @map("workspace_id")
  polarCustomerId    String             @map("polar_customer_id")
  polarSubscriptionId String            @unique @map("polar_subscription_id")
  polarProductId     String             @map("polar_product_id")
  status             SubscriptionStatus
  interval           BillingInterval
  /// Integer minor units. $29 monthly is 2900; $300 annual is 30000.
  amountMinor        Int                @map("amount_minor")
  currency           String             @default("USD")
  trialStartsAt      DateTime?          @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  pastDueSince       DateTime?          @map("past_due_since") @db.Timestamptz(6)
  lastReconciledAt   DateTime?          @map("last_reconciled_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  polarCustomer PolarCustomer @relation(fields: [polarCustomerId], references: [id], onDelete: Restrict)

  entitlements Entitlement[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([status, trialEndsAt])
  @@map("subscriptions")
  @@schema("private")
}

/// One public plan, no feature tiers. A limit is a number here, not a plan name.
model Entitlement {
  id             String          @id @default(dbgenerated("app.new_id('entitlement')"))
  workspaceId    String          @map("workspace_id")
  subscriptionId String?         @map("subscription_id")
  key            String
  kind           EntitlementKind
  booleanValue   Boolean?        @map("boolean_value")
  numericValue   Int?            @map("numeric_value")
  /// Where it came from: `polar_webhook`, `reconciliation` or `operator_grant`.
  source         String          @default("polar_webhook")
  effectiveFrom  DateTime        @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?       @map("effective_until") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("entitlements")
  @@schema("private")
}

/// Metered pass-through: managed X operations and AI text tokens. No media
/// generation meter exists in V1.
model UsageEvent {
  id            String   @id @default(dbgenerated("app.new_id('usage')"))
  workspaceId   String   @map("workspace_id")
  meterKey      String   @map("meter_key")
  quantity      Decimal  @db.Decimal(20, 6)
  unit          String
  costMinor     Int?     @map("cost_minor")
  costCurrency  String?  @map("cost_currency")
  provider      ProviderKind?
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  /// Unique per workspace so a retried report cannot double-charge.
  idempotencyKey String  @map("idempotency_key")
  reportedToPolarAt DateTime? @map("reported_to_polar_at") @db.Timestamptz(6)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([workspaceId, meterKey, occurredAt])
  @@map("usage_events")
  @@schema("private")
}

/// Global. Signature verification happens before any side effect, and the body
/// hash plus event ID make reprocessing idempotent.
model BillingWebhookInbox {
  id             String               @id @default(dbgenerated("app.new_id('billingevent')"))
  provider       String               @default("polar")
  eventId        String               @map("event_id")
  eventType      String               @map("event_type")
  signatureValid Boolean              @map("signature_valid")
  bodyHash       String               @map("body_hash")
  payload        Json
  state          InboxProcessingState @default(received)
  processingError String?             @map("processing_error")
  receivedAt     DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?            @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([state, receivedAt])
  @@map("billing_webhook_inbox")
  @@schema("private")
}

/// Disclosure acceptance is mandatory. No commission is ever conditional on a
/// positive review.
model AffiliatePartner {
  id                  String                @id @default(dbgenerated("app.new_id('aff')"))
  workspaceId         String                @map("workspace_id")
  contactUserId       String                @map("contact_user_id")
  displayName         String                @map("display_name")
  referralCode        String                @unique @map("referral_code") @db.Citext
  state               AffiliatePartnerState @default(applied)
  commissionRateBps   Int                   @default(2000) @map("commission_rate_bps")
  disclosureAcceptedAt DateTime?            @map("disclosure_accepted_at") @db.Timestamptz(6)
  disclosureVersion   String?               @map("disclosure_version")
  payoutMethod        String?               @map("payout_method")
  fraudFlags          Json                  @default("[]") @map("fraud_flags")
  approvedAt          DateTime?             @map("approved_at") @db.Timestamptz(6)
  terminatedAt        DateTime?             @map("terminated_at") @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  attributions ReferralAttribution[]
  commissions  CommissionLedger[]

  @@index([workspaceId])
  @@index([state])
  @@map("affiliate_partners")
  @@schema("private")
}

model ReferralAttribution {
  id                  String    @id @default(dbgenerated("app.new_id('referral')"))
  /// The referred workspace, which is the tenant that owns this row.
  workspaceId         String    @map("workspace_id")
  affiliatePartnerId  String    @map("affiliate_partner_id")
  referralCode        String    @map("referral_code") @db.Citext
  landingUrl          String?   @map("landing_url")
  referrerClass       String?   @map("referrer_class")
  attributedAt        DateTime  @default(now()) @map("attributed_at") @db.Timestamptz(6)
  convertedAt         DateTime? @map("converted_at") @db.Timestamptz(6)
  polarOrderId        String?   @map("polar_order_id")
  fraudReviewState    String    @default("pending") @map("fraud_review_state")
  fraudReviewNote     String?   @map("fraud_review_note")

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affiliatePartner AffiliatePartner @relation(fields: [affiliatePartnerId], references: [id], onDelete: Cascade)

  commissions CommissionLedger[]

  @@unique([workspaceId, affiliatePartnerId])
  @@index([workspaceId])
  @@index([affiliatePartnerId, attributedAt(sort: Desc)])
  @@map("referral_attributions")
  @@schema("private")
}

/// Immutable in spirit: a correction is a new offsetting row, never an edit.
model CommissionLedger {
  id                    String          @id @default(dbgenerated("app.new_id('commission')"))
  workspaceId           String          @map("workspace_id")
  affiliatePartnerId    String          @map("affiliate_partner_id")
  referralAttributionId String          @map("referral_attribution_id")
  payoutBatchId         String?         @map("payout_batch_id")
  polarOrderId          String          @map("polar_order_id")
  amountMinor           Int             @map("amount_minor")
  currency              String          @default("USD")
  state                 CommissionState @default(pending)
  holdUntil             DateTime?       @map("hold_until") @db.Timestamptz(6)
  reversalOfId          String?         @map("reversal_of_id")
  note                  String?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affiliatePartner    AffiliatePartner    @relation(fields: [affiliatePartnerId], references: [id], onDelete: Restrict)
  referralAttribution ReferralAttribution @relation(fields: [referralAttributionId], references: [id], onDelete: Restrict)
  payoutBatch         PayoutBatch?        @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)

  @@unique([polarOrderId, affiliatePartnerId, reversalOfId])
  @@index([workspaceId])
  @@index([affiliatePartnerId, state])
  @@map("commission_ledger")
  @@schema("private")
}

/// Operator level, not tenant owned. Service role only.
model PayoutBatch {
  id            String           @id @default(dbgenerated("app.new_id('payout')"))
  reference     String           @unique
  state         PayoutBatchState @default(open)
  periodStart   DateTime         @map("period_start") @db.Timestamptz(6)
  periodEnd     DateTime         @map("period_end") @db.Timestamptz(6)
  totalMinor    Int              @default(0) @map("total_minor")
  currency      String           @default("USD")
  exportedAt    DateTime?        @map("exported_at") @db.Timestamptz(6)
  paidAt        DateTime?        @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  commissions CommissionLedger[]

  @@index([state, periodEnd])
  @@map("payout_batches")
  @@schema("private")
}

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

/// Executing a deletion also cancels Temporal workflows, revokes provider
/// grants, deletes stored objects and tombstones analytics where required.
model DeletionRequest {
  id              String               @id @default(dbgenerated("app.new_id('deletion')"))
  workspaceId     String               @map("workspace_id")
  requestedByUserId String             @map("requested_by_user_id")
  scope           String
  subjectUserId   String?              @map("subject_user_id")
  state           DeletionRequestState @default(requested)
  reason          String?
  /// Cooling-off window before anything is destroyed.
  executeAfter    DateTime             @map("execute_after") @db.Timestamptz(6)
  verifiedAt      DateTime?            @map("verified_at") @db.Timestamptz(6)
  executedAt      DateTime?            @map("executed_at") @db.Timestamptz(6)
  canceledAt      DateTime?            @map("canceled_at") @db.Timestamptz(6)
  steps           Json                 @default("[]")
  failureNote     String?              @map("failure_note")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([state, executeAfter])
  @@map("deletion_requests")
  @@schema("app")
}

model DataExport {
  id              String          @id @default(dbgenerated("app.new_id('export')"))
  workspaceId     String          @map("workspace_id")
  requestedByUserId String        @map("requested_by_user_id")
  scope           String
  format          String          @default("json")
  state           DataExportState @default(requested)
  storageBucket   String?         @map("storage_bucket")
  storageKey      String?         @map("storage_key")
  byteSize        BigInt?         @map("byte_size")
  checksumSha256  String?         @map("checksum_sha256")
  downloadedAt    DateTime?       @map("downloaded_at") @db.Timestamptz(6)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(6)
  failureNote     String?         @map("failure_note")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([state, expiresAt])
  @@map("data_exports")
  @@schema("app")
}
