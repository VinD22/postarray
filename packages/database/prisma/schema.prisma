// Relay: system of record.
//
// Conventions enforced here and reviewed on every change:
//   * Every tenant-owned model carries `workspaceId` and indexes it. Row level
//     security in `migrations/0020_rls_policies.sql` is the second enforcement
//     point; Prisma is the third, never the first.
//   * Two physical schemas. `app` is safe to expose through a Data API with RLS.
//     `private` holds credentials, billing, OAuth and audit and is never granted
//     to `anon` or `authenticated`.
//   * Relay-owned primary and foreign keys are sortable prefixed identifiers.
//     PostgreSQL and every application surface use the same representation, so
//     RLS claims compare directly to tenant columns without an adapter layer.
//   * Actor columns such as `createdByUserId` are deliberately plain indexed
//     identifiers rather than declared relations. They point at `app.users` through a
//     foreign key added in SQL; keeping them out of the Prisma relation graph
//     avoids ~120 back-relation fields on `User` that nothing would traverse.
//   * Money is integer minor units plus an ISO 4217 code. Never a float.
//   * Instants are `timestamptz`; a wall-clock intent always ships with its IANA
//     zone in a sibling column.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  schemas    = ["app", "private"]
  extensions = [pgcrypto, citext]
}

