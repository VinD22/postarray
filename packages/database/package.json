{
  "name": "@relay/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tenancy": "./src/tenancy/index.ts",
    "./audit": "./src/audit/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "generate": "prisma generate",
    "migrate": "tsx src/migrate.ts",
    "migrations:verify": "tsx src/verify-migrations.ts",
    "seed": "tsx src/seed.ts",
    "test-user": "tsx src/test-user.ts",
    "reset": "tsx src/reset.ts",
    "studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@relay/connectors": "workspace:*",
    "@relay/contracts": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
